// | where Timestamp > ago(24h)
// | where IsInitiatingProcessRemoteSession == true
// | where FileName in~ (
//     "cmd.exe", "powershell.exe", "pwsh.exe",
//     "net.exe", "net1.exe", "nltest.exe",
//     "whoami.exe", "ipconfig.exe", "systeminfo.exe",
//     "tasklist.exe", "quser.exe", "query.exe",
//     "reg.exe", "rundll32.exe", "wmic.exe",
//     "mimikatz.exe", "procdump.exe", "psexec.exe"
// )
// | where AccountName !endswith "$"
// | project
//     Timestamp,
//     DeviceName,
//     AccountName,
//     FileName,
//     ProcessCommandLine,
//     InitiatingProcessFileName,
//     InitiatingProcessRemoteSessionDeviceName,
//     FolderPath,
