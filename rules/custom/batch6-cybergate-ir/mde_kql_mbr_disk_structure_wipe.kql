// | where AdditionalFields has_any ("PhysicalDrive", "HarddiskVolume")
// | where InitiatingProcessFileName !in~ (
//     "System", "chkdsk.exe", "defrag.exe", "vds.exe", "wbengine.exe"
// )
// | project Timestamp, DeviceName, AccountName, ActionType,
//           InitiatingProcessFileName, InitiatingProcessCommandLine,
//           AdditionalFields, ReportId
// | extend AlertTitle = "Raw Disk Read API Call (MBR Wipe Indicator)",
//          MitreTechnique = "T1561.002", Severity = "Critical"
