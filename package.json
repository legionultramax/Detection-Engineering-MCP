{
  "name": "harris-hawkeye-mcp",
  "version": "1.0.0",
  "description": "Harris HawkEye MCP - Security detection engineering, threat intelligence, CVE-to-detection, YARA conversion, and knowledge management for Claude Desktop",
  "sigmaSpecVersion": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "harris-hawkeye": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legionultramax/Detection-Engineering-MCP.git"
  },
  "homepage": "https://github.com/legionultramax/Detection-Engineering-MCP#readme",
  "bugs": {
    "url": "https://github.com/legionultramax/Detection-Engineering-MCP/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node tests/test.js",
    "tools:inventory": "node scripts/tool-inventory.mjs",
    "tools:check": "npm run build && node scripts/tool-inventory.mjs --check",
    "verify:readonly": "npm run build && node tests/verify-readonly-profiles.mjs",
    "verify:queries": "npm run build && node tests/verify-query-validation.mjs",
    "verify:search": "npm run build && node tests/verify-search-ranking.mjs",
    "verify:http": "npm run build && node tests/verify-http-transport.mjs",
    "verify:coverage": "npm run build && node tests/verify-translation-coverage.mjs",
    "verify:aql": "npm run build && node tests/verify-aql-bridge.mjs",
    "verify:authoring": "npm run build && node tests/verify-authoring-tools.mjs",
    "verify:gemma": "npm run build && node tests/verify-gemma-compat.mjs",
    "db:checkpoint": "node scripts/checkpoint-db.mjs",
    "preflight": "npm run build && node scripts/preflight.mjs",
    "fts:build": "npm run build && node scripts/build-fts.mjs",
    "fts:status": "npm run build && node scripts/build-fts.mjs --status",
    "catalog:build": "npm run build && node scripts/build-field-catalog.mjs",
    "catalog:report": "npm run build && node scripts/build-field-catalog.mjs --report",
    "lint": "tsc --noEmit --strict",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "keywords": [
    "mcp",
    "security",
    "detections",
    "sigma",
    "splunk",
    "escu",
    "elastic",
    "kql",
    "kusto",
    "defender",
    "sentinel",
    "siem",
    "mitre",
    "attack",
    "threat-intelligence",
    "cve",
    "nvd",
    "cisa-kev",
    "lolbas",
    "gtfobins",
    "yara",
    "ioc",
    "malware"
  ],
  "author": "Harris HawkEye",
  "license": "Apache-2.0",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.6.1",
    "pptxgenjs": "^4.0.1",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}


