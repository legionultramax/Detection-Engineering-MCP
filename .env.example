# =============================================================================
# Security Detections MCP Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or set these as system environment variables on your machine.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE — CRITICAL
# ---------------------------------------------------------------------------
# Path to the SQLite database file (detections + knowledge graph)
# Default: %TEMP%/security-detections-mcp/detections.db (UNSAFE — can be auto-cleaned)
# Recommended: Point to the data/ directory inside this project
DETECTIONS_DB_PATH=./data/detections.db

# ---------------------------------------------------------------------------
# API KEYS — Required for full functionality
# ---------------------------------------------------------------------------
# AlienVault OTX — IOC enrichment, actor pivots, pulse feeds
# Get yours: https://otx.alienvault.com/api
OTX_API_KEY=

# Malpedia — Malware family profiles, actor-to-family attribution
# Get yours: https://malpedia.caad.fkie.fraunhofer.de/usage/api
MALPEDIA_API_KEY=

# NIST NVD — CVE lookups (higher rate limit: 50 req/30s vs 5 without key)
# Get yours: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ---------------------------------------------------------------------------
# DETECTION RULE PATHS — Point to your local rule repositories
# ---------------------------------------------------------------------------
# Sigma rules directory (SigmaHQ or custom)
SIGMA_PATHS=./rules/sigma

# Splunk ESCU (Enterprise Security Content Updates) directory
SPLUNK_PATHS=./rules/splunk

# Elastic detection rules directory
ELASTIC_PATHS=./rules/elastic

# Microsoft Sentinel / KQL rules directory
KQL_PATHS=./rules/sentinel

# Splunk Security Stories (optional)
STORY_PATHS=./rules/splunk/stories

# ---------------------------------------------------------------------------
# MCP SERVER CONFIGURATION
# ---------------------------------------------------------------------------
# Server port (default: stdio transport, no port needed for Claude Desktop)
# MCP_PORT=3000

# Log level (debug | info | warn | error)
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# BROWSER AUTOMATION (optional — for WAT-20 custom source scraping)
# ---------------------------------------------------------------------------
# Playwright is auto-detected. No config needed if @playwright/mcp is installed.
# Chrome MCP is auto-detected via Claude Desktop extension.
# These are informational — the WAT-00 probe handles detection automatically.
